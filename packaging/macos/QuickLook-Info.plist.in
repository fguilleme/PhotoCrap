<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
<key>CFBundlePackageType</key><string>XPC!</string>
<key>CFBundleName</key><string>@PCR_NAME@</string>
<key>CFBundleDisplayName</key><string>@PCR_NAME@</string>
<key>CFBundleExecutable</key><string>@PCR_NAME@</string>
<key>CFBundleIdentifier</key><string>@PCR_ID@</string>
<key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
<key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>LSMinimumSystemVersion</key><string>12.0</string>
<key>NSExtension</key><dict>
 <key>NSExtensionPointIdentifier</key><string>@PCR_POINT@</string>
 <key>NSExtensionPrincipalClass</key><string>@PCR_CLASS@</string>
 <key>NSExtensionAttributes</key><dict>
   <key>QLSupportedContentTypes</key><array><string>org.photocrap.project</string></array>
   @PCR_ATTRIBUTES@
 </dict>
</dict>
</dict></plist>
